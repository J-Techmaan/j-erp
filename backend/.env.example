APP_ENV=development
# Enable with HTTPS in production. Authentication session tokens are generated
# securely on the server and stored only as hashes in the database.
SESSION_COOKIE_SECURE=false
SESSION_HOURS=8
PERSISTENT_SESSION_DAYS=30
DATABASE_URL=sqlite:///./erp.db
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=10485760
ALLOWED_EXTENSIONS=.txt,.pdf,.png,.jpg,.jpeg,.csv,.xlsx,.docx
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://YOUR_LAN_IP:5173
PUBLIC_ORIGIN=
